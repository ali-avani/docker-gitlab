# Used by bash ./install.sh. Empty values are asked for.

# gitlab (GitLab and runner) | runner (runner only)
INSTALL_TYPE=

# --- gitlab ---

# Domain of GitLab, e.g. gitlab.example.com
GITLAB_DOMAIN=

# GitLab tag with edition suffix
GITLAB_VERSION=19.4.1-ee.0

# Optional image repository, for a mirror (default: gitlab/gitlab-ee)
# GITLAB_IMAGE=

# Registry domain. Empty = no registry
REGISTRY_DOMAIN=

GITLAB_TIMEZONE=UTC

# Host port for git over SSH
GITLAB_SSH_PORT=22

# true = settings for small servers
GITLAB_LOW_MEMORY=true

# Email. Empty SMTP_HOST = off
SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_DOMAIN=
# SMTP_FROM=
SMTP_VERIFY_NONE=true

# --- runner ---

RUNNER_VERSION=v19.4.1

# Optional image repository (default: gitlab/gitlab-runner)
# RUNNER_IMAGE=

# GitLab URL for the runner (public URL for a runner-only install)
RUNNER_URL=http://gitlab:80

# RUNNER_NAME=
RUNNER_CONCURRENT=2
RUNNER_LIMIT=2
RUNNER_DOCKER_IMAGE=docker:latest
RUNNER_PRIVILEGED=true
RUNNER_MEMORY=2g

# Set by the installer
COMPOSE_FILE=
COMPOSE_PROFILES=
