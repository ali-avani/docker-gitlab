# Settings and secrets generated by install.sh
.env
/omnibus_config.rb
/docker-compose.override.yaml

# Runner configuration (contains the runner token)
gitlab-runner/*
!gitlab-runner/.gitkeep

# Extra certificates GitLab should trust
trusted-certs/

# Backups and temporary files
*.bak
*.bak.*
*.tmp
*.log

# OS generated files
.DS_Store
Thumbs.db
